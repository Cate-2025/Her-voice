  "components": {
    "schemas": {
      "CaseStatus": {
        "type": "string",
        "enum": [
          "draft",
          "submitted",
          "received",
          "under_review",
          "action_required",
          "closed"
        ],
        "title": "CaseStatus"
      },
      "CaseStatusUpdate": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CaseStatus"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CaseStatusUpdate"
      },
      "EvidenceDownloadTarget": {
        "properties": {
          "download_url": {
            "type": "string",
            "title": "Download Url"
          }
        },
        "type": "object",
        "required": [
          "download_url"
        ],
        "title": "EvidenceDownloadTarget"
      },
      "EvidenceSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "original_name": {
            "type": "string",
            "title": "Original Name"
          },
          "content_type": {
            "type": "string",
            "title": "Content Type"
          },
          "byte_size": {
            "type": "integer",
            "title": "Byte Size"
          },
          "verification_status": {
            "type": "string",
            "title": "Verification Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "original_name",
          "content_type",
          "byte_size",
          "verification_status"
        ],
        "title": "EvidenceSummary"
      },
      "EvidenceUploadRequest": {
        "properties": {
          "original_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Original Name"
          },
          "content_type": {
            "type": "string",
            "pattern": "^(image/(jpeg|png)|application/pdf|audio/(mpeg|mp4))$",
            "title": "Content Type"
          },
          "byte_size": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Byte Size"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$",
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "original_name",
          "content_type",
          "byte_size",
          "sha256"
        ],
        "title": "EvidenceUploadRequest"
      },
      "EvidenceUploadTarget": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid",
            "title": "Evidence Id"
          },
          "object_key": {
            "type": "string",
            "title": "Object Key"
          },
          "upload_url": {
            "type": "string",
            "title": "Upload Url"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "object_key",
          "upload_url"
        ],
        "title": "EvidenceUploadTarget"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "NotificationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "read_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Read At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "body",
          "read_at",
          "created_at"
        ],
        "title": "NotificationResponse"
      },
      "OfficerCaseDetail": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "report_mode": {
            "$ref": "#/components/schemas/ReportMode"
          },
          "case_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Code"
          },
          "subject_staff_ref": {
            "type": "string",
            "title": "Subject Staff Ref"
          },
          "course_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Course Ref"
          },
          "status": {
            "$ref": "#/components/schemas/CaseStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "submitted_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submitted At"
          },
          "assigned_officer_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned Officer Id"
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/TimelineEventResponse"
            },
            "type": "array",
            "title": "Timeline"
          }
        },
        "type": "object",
        "required": [
          "id",
          "report_mode",
          "case_code",
          "subject_staff_ref",
          "course_ref",
          "status",
          "created_at",
          "submitted_at",
          "assigned_officer_id",
          "timeline"
        ],
        "title": "OfficerCaseDetail"
      },
      "OfficerReportResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "report_mode": {
            "$ref": "#/components/schemas/ReportMode"
          },
          "case_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Code"
          },
          "subject_staff_ref": {
            "type": "string",
            "title": "Subject Staff Ref"
          },
          "course_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Course Ref"
          },
          "status": {
            "$ref": "#/components/schemas/CaseStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
