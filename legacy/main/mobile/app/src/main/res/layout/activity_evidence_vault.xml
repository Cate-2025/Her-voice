<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gradient_start"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Evidence Vault"
        android:textColor="@color/pink_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Securely attach screenshots, messages, emails, or audio records to substantiate your reports. All stored files are encrypted locally."
        android:textColor="@color/text_light"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_select_file"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/pink_primary"
        android:text="Choose Document / Screenshot"
        android:textColor="@color/white"
        app:cornerRadius="28dp" />

    <Button
        android:id="@+id/btn_record_audio"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Record Permitted Audio Note"
        android:textColor="@color/pink_primary"
        app:cornerRadius="28dp"
        app:strokeColor="@color/pink_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Attached Evidence Files:"
        android:textColor="@color/text_dark"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white">

        <ListView
            android:id="@+id/lv_evidence"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/pink_light"
            android:dividerHeight="1dp"
            android:padding="8dp" />
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btn_upload_vault"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/pink_accent"
        android:text="Sync &amp; Upload Evidence to Server"
        android:textColor="@color/white"
        app:cornerRadius="28dp" />

</LinearLayout>
