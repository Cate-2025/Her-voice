APP_ENV=development
DATABASE_URL=postgresql+psycopg://hervoice:replace-this-password@postgres:5432/hervoice
# Optional direct URL for migrations when DATABASE_URL uses transaction pooling.
# DATABASE_URL_UNPOOLED=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST/DB_NAME?sslmode=verify-full
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=replace-this-key
OBJECT_STORAGE_SECRET_KEY=replace-this-secret
OBJECT_STORAGE_BUCKET=hervoice-evidence
MAX_EVIDENCE_BYTES=10485760

# Opt in only after configuring server Firebase credentials; see docs/DEPLOYMENT.md
PUSH_ENABLED=false
# Export GOOGLE_APPLICATION_CREDENTIALS in the server environment, not only this file.

# Verified email; choose file only for fictional development, smtp for real mail
EMAIL_DELIVERY=disabled
EMAIL_PREVIEW_PATH=.prototype/mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# The prototype runner overrides these with private local storage
EVIDENCE_STORAGE=s3
LOCAL_EVIDENCE_PATH=.prototype/evidence

# Gmail API over HTTPS (alternative to SMTP, supported on Render Free)
# EMAIL_DELIVERY=gmail_api
# GMAIL_SENDER=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
