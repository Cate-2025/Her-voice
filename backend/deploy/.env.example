# Copy to .env on the host; protect it with chmod 600. Never commit real values.
HERVOICE_HOST=api.your-domain.org
HERVOICE_IMAGE=hervoice-api:v1-candidate
APP_ENV=staging
DATABASE_URL=postgresql+psycopg://hervoice:replace-password@private-db:5432/hervoice?sslmode=verify-full
# Supply Neon's direct URL here when DATABASE_URL is pooled; optional otherwise.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DB_NAME?sslmode=verify-full
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["https://api.your-domain.org"]
EVIDENCE_STORAGE=s3
OBJECT_STORAGE_ENDPOINT=https://your-private-s3-endpoint
OBJECT_STORAGE_ACCESS_KEY=replace-access-key
OBJECT_STORAGE_SECRET_KEY=replace-secret-key
OBJECT_STORAGE_BUCKET=hervoice-evidence
MAX_EVIDENCE_BYTES=10485760
EMAIL_DELIVERY=smtp
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=HERVOICE <support@your-domain.org>
SMTP_USER=replace-mail-user
SMTP_PASSWORD=replace-mail-password
PUSH_ENABLED=false
# Enable with the optional Firebase override after configuring server credentials.

# Gmail API over HTTPS (alternative to SMTP, supported on Render Free)
# EMAIL_DELIVERY=gmail_api
# GMAIL_SENDER=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
