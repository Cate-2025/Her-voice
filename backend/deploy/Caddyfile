{$HERVOICE_HOST} {
    request_body {
        max_size 10485760
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control "no-store"
        -Server
    }
    reverse_proxy api:8000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 90s
        }
    }
}
